# Supabase 项目凭证：Supabase 后台 → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi……

# 服务端专用密钥（仅服务端使用，拥有绕过 RLS 的权限，切勿写入前端）
# 只在图片转存到 Storage 这类服务端操作里用到
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi……

# 可选：Bangumi API 的 User-Agent（Bangumi 要求规范 UA，建议填你的联系方式）
BANGUMI_UA=GameCollector/1.0 (your-email@example.com)
